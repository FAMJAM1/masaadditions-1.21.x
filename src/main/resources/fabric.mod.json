{
  "schemaVersion": 1,
  "id": "masaadditions",
  "version": "${version}",
  "name": "MasaAdditions",
  "description": "Unofficial Fabric port of MasaAdditions, an add-on for masa's Tweakeroo, MiniHUD and Litematica.",
  "authors": [
    "FAMJAM"
  ],
  "contributors": [
    "hp3721"
  ],
  "contact": {
    "homepage": "https://github.com/FAMJAM1/masaadditions-port",
    "sources": "https://github.com/FAMJAM1/masaadditions-port",
    "issues": "https://github.com/FAMJAM1/masaadditions-port/issues"
  },
  "license": "GPL-3.0",
  "icon": "masaadditions-icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.red.masaadditions.MasaAdditions"
    ]
  },
  "mixins": [
    "masaadditions.tweakeroo_additions.tweakeroo_mixin.json",
    "masaadditions.tweakeroo_additions.mixin.json",
    "masaadditions.minihud_additions.minihud_mixin.json",
    "masaadditions.minihud_additions.mixin.json",
    "masaadditions.litematica_additions.litematica_mixin.json",
    "masaadditions.litematica_additions.mixin.json"
  ],
  "accessWidener": "masaadditions.accesswidener",
  "depends": {
    "minecraft": ">=1.21.9 <1.21.11",
    "malilib": ">=0.26.8- <0.27.0-"
  },
  "suggests": {
    "tweakeroo": ">=0.26.5",
    "litematica": ">=0.24.9",
    "minihud": ">=0.37.6"
  },
  "breaks": {
    "tweakeroo": "<0.26.5",
    "litematica": "<0.24.9",
    "minihud": "<0.37.6"
  }
}
